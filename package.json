{
  "name": "easypops",
  "version": "0.0.2-dev.0",
  "license": "MIT",
  "packageManager": "npm@12.0.1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/bindings/dom/index.d.ts",
      "import": "./dist/bindings/dom/index.js"
    },
    "./lit": {
      "types": "./dist/bindings/lit/index.d.ts",
      "import": "./dist/bindings/lit/index.js"
    },
    "./react": {
      "types": "./dist/bindings/react/index.d.ts",
      "import": "./dist/bindings/react/index.js"
    },
    "./picolingo": {
      "types": "./dist/i18n/picolingo/index.d.ts",
      "import": "./dist/i18n/picolingo/index.js"
    },
    "./picolingo/english": {
      "types": "./dist/i18n/picolingo/english.d.ts",
      "import": "./dist/i18n/picolingo/english.js"
    },
    "./picolingo/german": {
      "types": "./dist/i18n/picolingo/german.d.ts",
      "import": "./dist/i18n/picolingo/german.js"
    },
    "./themes/webawesome": {
      "types": "./dist/themes/webawesome.d.ts",
      "import": "./dist/themes/webawesome.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc",
    "build": "tsc && rm -rf dist && tsc -p tsconfig.build.json && node --experimental-strip-types scripts/strip-css-comments.mts",
    "build:release": "npm run build && node scripts/pack-source.mts",
    "build:demo": "vite build",
    "preview": "vite preview",
    "size": "npm run build && size-limit",
    "loc": "sloc src/main",
    "loc:src": "sloc . --exclude 'node_modules|coverage|dist|\\.test\\.|\\.config\\.'",
    "loc:json": "sloc src/main --format json"
  },
  "devDependencies": {
    "@mantine/core": "9.5.1",
    "@mantine/dates": "9.5.1",
    "@mantine/form": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@size-limit/preset-small-lib": "13.0.3",
    "@types/archiver": "8.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "archiver": "8.0.0",
    "dayjs": "1.11.23",
    "lit": "3.3.3",
    "picolingo": "0.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "size-limit": "13.0.3",
    "sloc": "0.3.2",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "lit-html": "^3.0.0",
    "picolingo": "^0.0.2",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "lit-html": {
      "optional": true
    },
    "picolingo": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
